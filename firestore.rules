rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() < 100;
    }

    // Videos rules
    match /videos/{videoId} {
      allow read: if true;
      allow write: if true; // Managed secure updates via Express server
    }

    // Unlock progress rules
    match /unlocks/{unlockId} {
      allow read, write: if true; // Read/write user progress
    }

    // Global settings rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
